# ─── Application ───
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL) ───
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=auto_apply_job

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Authentication ───
# Generate a unique random secret with at least 32 characters for each environment.
JWT_SECRET=
JWT_EXPIRATION=7d

# ─── Encryption ───
ENCRYPTION_KEY=

# ─── AI ───
GEMINI_API_KEY=

# ─── File Storage (local) ───
STORAGE_PATH=./uploads

# ─── Email (optional; only real SMTP is used) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Browser automation (optional) ───
BROWSER_EXECUTABLE_PATH=

# Optional Jobicy commercial feed key. May incur per-job charges for direct employer URLs.
# Without a key, Jobicy returns listing URLs; application must continue on the employer site.
JOBICY_API_KEY=

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:3001
