# ─── Encryption ───
ENCRYPTION_KEY=

# ─── AI ───
GEMINI_API_KEY=

# ─── File Storage (local) ───
STORAGE_PATH=./uploads

# ─── Job Sources (only for authorized integrations) ───
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
